<ribbon:RibbonWindow x:Class="Seitenwerk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ribbon="clr-namespace:System.Windows.Controls.Ribbon;assembly=System.Windows.Controls.Ribbon"
        xmlns:s="clr-namespace:Seitenwerk.Werkzeuge"
        xmlns:modell="clr-namespace:Seitenwerk.Core.Modell;assembly=Seitenwerk.Core"
        Title="Seitenwerk" Width="1320" Height="820" MinWidth="760" MinHeight="520"
        AllowDrop="True" Drop="DateiAbgelegt" DragOver="DateiUeberFenster"
        Icon="pack://application:,,,/Seitenwerk.ico">
    <Window.Resources>
        <DataTemplate x:Key="SchriftVorlage">
            <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="15" Margin="4,1"/>
        </DataTemplate>
        <Style x:Key="SeitenRahmen" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,28"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ribbon:Ribbon x:Name="Menueband" Grid.Row="0">

            <!-- ============================ Schnellzugriff ============================ -->
            <ribbon:Ribbon.QuickAccessToolBar>
                <ribbon:RibbonQuickAccessToolBar>
                    <ribbon:RibbonButton SmallImageSource="{s:Symbol Glyph=E74E}" Tag="Datei.Speichern" Click="Befehl" ToolTipTitle="Speichern" ToolTipDescription="Strg+S"/>
                    <ribbon:RibbonButton SmallImageSource="{s:Symbol Glyph=E7A7}" Tag="Bearbeiten.Rueckgaengig" Click="Befehl" ToolTipTitle="Rückgängig" ToolTipDescription="Strg+Z"/>
                    <ribbon:RibbonButton SmallImageSource="{s:Symbol Glyph=E7A6}" Tag="Bearbeiten.Wiederholen" Click="Befehl" ToolTipTitle="Wiederholen" ToolTipDescription="Strg+Y"/>
                </ribbon:RibbonQuickAccessToolBar>
            </ribbon:Ribbon.QuickAccessToolBar>

            <!-- ============================ Datei ============================ -->
            <ribbon:Ribbon.ApplicationMenu>
                <ribbon:RibbonApplicationMenu Label="Datei" SmallImageSource="{s:Symbol Glyph=E700, Farbe=#FFFFFF}">
                    <ribbon:RibbonApplicationMenuItem Header="Neu" Tag="Datei.Neu" Click="Befehl" ImageSource="{s:Symbol Skizze=SeiteNeu}"/>
                    <ribbon:RibbonApplicationMenuItem Header="Öffnen …" Tag="Datei.Oeffnen" Click="Befehl" ImageSource="{s:Symbol Glyph=E838}"/>
                    <ribbon:RibbonApplicationMenuItem Header="Speichern" Tag="Datei.Speichern" Click="Befehl" ImageSource="{s:Symbol Glyph=E74E}"/>
                    <ribbon:RibbonApplicationMenuItem Header="Speichern unter …" Tag="Datei.SpeichernUnter" Click="Befehl" ImageSource="{s:Symbol Glyph=E792}"/>
                    <ribbon:RibbonSeparator/>
                    <ribbon:RibbonApplicationSplitMenuItem Header="Exportieren" ImageSource="{s:Symbol Glyph=E724}">
                        <ribbon:RibbonApplicationMenuItem Header="Als PDF-Datei …" Tag="Datei.Pdf" Click="Befehl" ImageSource="{s:Symbol Skizze=Seite}"/>
                        <ribbon:RibbonApplicationMenuItem Header="Seiten als Bilder (PNG) …" Tag="Datei.Png" Click="Befehl" ImageSource="{s:Symbol Skizze=Bild}"/>
                    </ribbon:RibbonApplicationSplitMenuItem>
                    <ribbon:RibbonApplicationMenuItem Header="Drucken …" Tag="Datei.Drucken" Click="Befehl" ImageSource="{s:Symbol Glyph=E749}"/>
                    <ribbon:RibbonSeparator/>
                    <ribbon:RibbonApplicationMenuItem Header="LibreOffice für .pub-Dateien festlegen …" Tag="Datei.LibreOffice" Click="Befehl" ImageSource="{s:Symbol Glyph=E713}"/>
                    <ribbon:RibbonApplicationMenuItem Header="Info" Tag="Datei.Info" Click="Befehl" ImageSource="{s:Symbol Glyph=E946}"/>
                    <ribbon:RibbonApplicationMenuItem Header="Beenden" Tag="Datei.Beenden" Click="Befehl" ImageSource="{s:Symbol Glyph=E711}"/>

                    <ribbon:RibbonApplicationMenu.AuxiliaryPaneContent>
                        <StackPanel Margin="8">
                            <TextBlock Text="Zuletzt geöffnet" FontWeight="SemiBold" Margin="4,4,4,8"/>
                            <ItemsControl x:Name="ZuletztListe"/>
                            <TextBlock x:Name="ZuletztLeer" Text="Noch keine Dateien" Foreground="Gray" Margin="4"/>
                        </StackPanel>
                    </ribbon:RibbonApplicationMenu.AuxiliaryPaneContent>
                </ribbon:RibbonApplicationMenu>
            </ribbon:Ribbon.ApplicationMenu>

            <!-- ============================ Start ============================ -->
            <ribbon:RibbonTab Header="Start" KeyTip="S">

                <ribbon:RibbonGroup Header="Zwischenablage">
                    <ribbon:RibbonButton Label="Einfügen" LargeImageSource="{s:Symbol Glyph=E77F}" Tag="Bearbeiten.Einfuegen" Click="Befehl" ToolTipTitle="Einfügen" ToolTipDescription="Fügt Objekte, ein Bild oder Text aus der Zwischenablage ein (Strg+V)."/>
                    <ribbon:RibbonButton Label="Ausschneiden" SmallImageSource="{s:Symbol Glyph=E8C6}" Tag="Bearbeiten.Ausschneiden" Click="Befehl"/>
                    <ribbon:RibbonButton Label="Kopieren" SmallImageSource="{s:Symbol Glyph=E8C8}" Tag="Bearbeiten.Kopieren" Click="Befehl"/>
                    <ribbon:RibbonButton Label="Duplizieren" SmallImageSource="{s:Symbol Skizze=Duplizieren}" Tag="Bearbeiten.Duplizieren" Click="Befehl"/>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="Schriftart">
                    <ribbon:RibbonControlGroup>
                        <ribbon:RibbonComboBox x:Name="SchriftartBox" SelectionBoxWidth="150" IsEditable="True" ToolTipTitle="Schriftart" PreviewKeyDown="SchriftartTaste">
                            <ribbon:RibbonGallery x:Name="SchriftartGalerie" MaxColumnCount="1" SelectionChanged="SchriftartGewaehlt">
                                <ribbon:RibbonGalleryCategory x:Name="SchriftartKategorie" ItemTemplate="{StaticResource SchriftVorlage}"/>
                            </ribbon:RibbonGallery>
                        </ribbon:RibbonComboBox>
                        <ribbon:RibbonComboBox x:Name="GroesseBox" SelectionBoxWidth="40" IsEditable="True" ToolTipTitle="Schriftgröße (Punkt)" PreviewKeyDown="GroesseTaste">
                            <ribbon:RibbonGallery x:Name="GroesseGalerie" MaxColumnCount="1" SelectionChanged="GroesseGewaehlt">
                                <ribbon:RibbonGalleryCategory x:Name="GroesseKategorie"/>
                            </ribbon:RibbonGallery>
                        </ribbon:RibbonComboBox>
                        <ribbon:RibbonButton SmallImageSource="{s:Symbol Glyph=E8E7}" Tag="Schrift.Groesser" Click="Befehl" ToolTipTitle="Schrift vergrößern"/>
                        <ribbon:RibbonButton SmallImageSource="{s:Symbol Glyph=E8E8}" Tag="Schrift.Kleiner" Click="Befehl" ToolTipTitle="Schrift verkleinern"/>
                    </ribbon:RibbonControlGroup>
                    <ribbon:RibbonControlGroup>
                        <ribbon:RibbonToggleButton x:Name="FettKnopf" SmallImageSource="{s:Symbol Glyph=E8DD}" Tag="Format.Fett" Click="Umschalter" ToolTipTitle="Fett" ToolTipDescription="Strg+B"/>
                        <ribbon:RibbonToggleButton x:Name="KursivKnopf" SmallImageSource="{s:Symbol Glyph=E8DB}" Tag="Format.Kursiv" Click="Umschalter" ToolTipTitle="Kursiv" ToolTipDescription="Strg+I"/>
                        <ribbon:RibbonToggleButton x:Name="UnterstrichenKnopf" SmallImageSource="{s:Symbol Glyph=E8DC}" Tag="Format.Unterstrichen" Click="Umschalter" ToolTipTitle="Unterstrichen" ToolTipDescription="Strg+U"/>
                        <ribbon:RibbonToggleButton x:Name="DurchgestrichenKnopf" SmallImageSource="{s:Symbol Skizze='M4,16 H28 M10,8 H22 M10,24 H22'}" Tag="Format.Durchgestrichen" Click="Umschalter" ToolTipTitle="Durchgestrichen"/>
                        <ribbon:RibbonSplitButton x:Name="SchriftfarbeKnopf" SmallImageSource="{s:Symbol Glyph=E8D3}" Tag="Farbe.Schrift" Click="Befehl" ToolTipTitle="Schriftfarbe"/>
                    </ribbon:RibbonControlGroup>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="Absatz">
                    <ribbon:RibbonControlGroup>
                        <ribbon:RibbonToggleButton x:Name="LinksKnopf" SmallImageSource="{s:Symbol Skizze=Links}" Tag="Absatz.Links" Click="Umschalter" ToolTipTitle="Linksbündig"/>
                        <ribbon:RibbonToggleButton x:Name="ZentriertKnopf" SmallImageSource="{s:Symbol Skizze=Zentriert}" Tag="Absatz.Zentriert" Click="Umschalter" ToolTipTitle="Zentriert"/>
                        <ribbon:RibbonToggleButton x:Name="RechtsKnopf" SmallImageSource="{s:Symbol Skizze=Rechts}" Tag="Absatz.Rechts" Click="Umschalter" ToolTipTitle="Rechtsbündig"/>
                        <ribbon:RibbonToggleButton x:Name="BlocksatzKnopf" SmallImageSource="{s:Symbol Skizze=Blocksatz}" Tag="Absatz.Blocksatz" Click="Umschalter" ToolTipTitle="Blocksatz"/>
                    </ribbon:RibbonControlGroup>
                    <ribbon:RibbonMenuButton Label="Zeilenabstand" SmallImageSource="{s:Symbol Skizze='M12,6 H28 M12,16 H28 M12,26 H28 M5,9 V23 M2,12 L5,8 L8,12 M2,20 L5,24 L8,20'}">
                        <ribbon:RibbonMenuItem Header="1,0" Tag="Absatz.Zeile.1" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="1,15" Tag="Absatz.Zeile.1.15" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="1,5" Tag="Absatz.Zeile.1.5" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="2,0" Tag="Absatz.Zeile.2" Click="Befehl"/>
                    </ribbon:RibbonMenuButton>
                    <ribbon:RibbonMenuButton Label="Text ausrichten" SmallImageSource="{s:Symbol Skizze='M4,4 H28 V28 H4 Z M9,12 H23 M9,17 H23'}">
                        <ribbon:RibbonMenuItem Header="Oben" Tag="Text.Oben" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="Mitte" Tag="Text.Mitte" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="Unten" Tag="Text.Unten" Click="Befehl"/>
                    </ribbon:RibbonMenuButton>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="Objekte">
                    <ribbon:RibbonToggleButton x:Name="TextfeldKnopfStart" Label="Textfeld" LargeImageSource="{s:Symbol Skizze=Textfeld}" Tag="Werkzeug.Textfeld" Click="Befehl" ToolTipTitle="Textfeld zeichnen" ToolTipDescription="Ziehen Sie auf der Seite ein Textfeld auf."/>
                    <ribbon:RibbonButton Label="Bild" LargeImageSource="{s:Symbol Skizze=Bild}" Tag="Einfuegen.Bild" Click="Befehl" ToolTipTitle="Bild einfügen"/>
                    <ribbon:RibbonMenuButton x:Name="FormenMenueStart" Label="Formen" LargeImageSource="{s:Symbol Form=Ellipse}" ToolTipTitle="Formen"/>
                    <ribbon:RibbonToggleButton x:Name="LinieKnopfStart" Label="Linie" SmallImageSource="{s:Symbol Skizze=Linie}" Tag="Werkzeug.Linie" Click="Befehl"/>
                    <ribbon:RibbonToggleButton x:Name="PfeilKnopfStart" Label="Pfeil" SmallImageSource="{s:Symbol Skizze=Pfeil}" Tag="Werkzeug.Pfeil" Click="Befehl"/>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="Formatierung">
                    <ribbon:RibbonSplitButton x:Name="FuellfarbeKnopf" Label="Füllfarbe" LargeImageSource="{s:Symbol Glyph=E790}" Tag="Farbe.Fuellung" Click="Befehl" ToolTipTitle="Füllfarbe"/>
                    <ribbon:RibbonSplitButton x:Name="LinienfarbeKnopf" Label="Linienfarbe" SmallImageSource="{s:Symbol Skizze=Raender}" Tag="Farbe.Linie" Click="Befehl" ToolTipTitle="Linienfarbe"/>
                    <ribbon:RibbonMenuButton Label="Linienstärke" SmallImageSource="{s:Symbol Skizze='M4,7 H28 M4,14 H28 M4,23 H28' }">
                        <ribbon:RibbonMenuItem Header="Keine Linie" Tag="Linie.Staerke.0" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="0,5 Pt" Tag="Linie.Staerke.0.5" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="1 Pt" Tag="Linie.Staerke.1" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="2 Pt" Tag="Linie.Staerke.2" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="3 Pt" Tag="Linie.Staerke.3" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="4,5 Pt" Tag="Linie.Staerke.4.5" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="6 Pt" Tag="Linie.Staerke.6" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="10 Pt" Tag="Linie.Staerke.10" Click="Befehl"/>
                    </ribbon:RibbonMenuButton>
                    <ribbon:RibbonMenuButton Label="Linienart" SmallImageSource="{s:Symbol Skizze='M4,16 H10 M14,16 H20 M24,16 H28'}">
                        <ribbon:RibbonMenuItem Header="Durchgezogen" Tag="Linie.Art.Durchgezogen" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="Gestrichelt" Tag="Linie.Art.Gestrichelt" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="Gepunktet" Tag="Linie.Art.Gepunktet" Click="Befehl"/>
                        <ribbon:RibbonSeparator/>
                        <ribbon:RibbonMenuItem Header="Ohne Pfeilspitzen" Tag="Linie.Pfeil.Keine" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="Pfeilspitze am Ende" Tag="Linie.Pfeil.Ende" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="Pfeilspitzen an beiden Enden" Tag="Linie.Pfeil.Beide" Click="Befehl"/>
                    </ribbon:RibbonMenuButton>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Header="Anordnen">
                    <ribbon:RibbonButton Label="In den Vordergrund" SmallImageSource="{s:Symbol Skizze=Vordergrund}" Tag="Anordnen.Vordergrund" Click="Befehl"/>
                    <ribbon:RibbonButton Label="In den Hintergrund" SmallImageSource="{s:Symbol Skizze=Hintergrund}" Tag="Anordnen.Hintergrund" Click="Befehl"/>
                    <ribbon:RibbonButton Label="Gruppieren" SmallImageSource="{s:Symbol Skizze=Gruppe}" Tag="Anordnen.Gruppieren" Click="Befehl"/>
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>

            <!-- ============================ Einfügen ============================ -->
            <ribbon:RibbonTab Header="Einfügen" KeyTip="E">
                <ribbon:RibbonGroup Header="Seiten">
                    <ribbon:RibbonButton Label="Seite einfügen" LargeImageSource="{s:Symbol Skizze=SeiteNeu}" Tag="Seite.Neu" Click="Befehl" ToolTipTitle="Leere Seite einfügen" ToolTipDescription="Fügt hinter der aktuellen Seite eine leere Seite ein."/>
                    <ribbon:RibbonButton Label="Seite duplizieren" SmallImageSource="{s:Symbol Skizze=SeiteKopie}" Tag="Seite.Duplizieren" Click="Befehl"/>
                    <ribbon:RibbonButton Label="Seite löschen" SmallImageSource="{s:Symbol Skizze=SeiteWeg}" Tag="Seite.Loeschen" Click="Befehl"/>
                    <ribbon:RibbonButton Label="Seite nach vorn" SmallImageSource="{s:Symbol Glyph=E74A}" Tag="Seite.Vor" Click="Befehl"/>
                    <ribbon:RibbonButton Label="Seite nach hinten" SmallImageSource="{s:Symbol Glyph=E74B}" Tag="Seite.Zurueck" Click="Befehl"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="Objekte">
                    <ribbon:RibbonToggleButton x:Name="TextfeldKnopfEinfuegen" Label="Textfeld" LargeImageSource="{s:Symbol Skizze=Textfeld}" Tag="Werkzeug.Textfeld" Click="Befehl"/>
                    <ribbon:RibbonButton Label="Bild" LargeImageSource="{s:Symbol Skizze=Bild}" Tag="Einfuegen.Bild" Click="Befehl"/>
                    <ribbon:RibbonMenuButton x:Name="FormenMenueEinfuegen" Label="Formen" LargeImageSource="{s:Symbol Form=Ellipse}"/>
                    <ribbon:RibbonToggleButton x:Name="LinieKnopfEinfuegen" Label="Linie" SmallImageSource="{s:Symbol Skizze=Linie}" Tag="Werkzeug.Linie" Click="Befehl"/>
                    <ribbon:RibbonToggleButton x:Name="PfeilKnopfEinfuegen" Label="Pfeil" SmallImageSource="{s:Symbol Skizze=Pfeil}" Tag="Werkzeug.Pfeil" Click="Befehl"/>
                    <ribbon:RibbonButton Label="Bild aus Zwischenablage" SmallImageSource="{s:Symbol Glyph=E77F}" Tag="Bearbeiten.Einfuegen" Click="Befehl"/>
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>

            <!-- ============================ Seitenentwurf ============================ -->
            <ribbon:RibbonTab Header="Seitenentwurf" KeyTip="D">
                <ribbon:RibbonGroup Header="Seite einrichten">
                    <ribbon:RibbonButton Label="Seite einrichten …" LargeImageSource="{s:Symbol Skizze=Seite}" Tag="Seite.Einrichten" Click="Befehl" ToolTipTitle="Seite einrichten" ToolTipDescription="Papierformat, Ausrichtung und Ränder."/>
                    <ribbon:RibbonMenuButton x:Name="FormatMenue" Label="Größe" LargeImageSource="{s:Symbol Skizze=GanzeSeite}"/>
                    <ribbon:RibbonMenuButton Label="Ausrichtung" LargeImageSource="{s:Symbol Skizze=Quer}">
                        <ribbon:RibbonMenuItem Header="Hochformat" ImageSource="{s:Symbol Skizze=Hoch}" Tag="Seite.Hoch" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="Querformat" ImageSource="{s:Symbol Skizze=Quer}" Tag="Seite.Quer" Click="Befehl"/>
                    </ribbon:RibbonMenuButton>
                    <ribbon:RibbonMenuButton Label="Ränder" LargeImageSource="{s:Symbol Skizze=Raender}">
                        <ribbon:RibbonMenuItem Header="Normal (10 mm)" Tag="Raender.10" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="Schmal (5 mm)" Tag="Raender.5" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="Breit (25 mm)" Tag="Raender.25" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="Keine" Tag="Raender.0" Click="Befehl"/>
                    </ribbon:RibbonMenuButton>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="Seitenhintergrund">
                    <ribbon:RibbonSplitButton x:Name="HintergrundKnopf" Label="Hintergrundfarbe" LargeImageSource="{s:Symbol Glyph=E790}" Tag="Farbe.Hintergrund" Click="Befehl" ToolTipTitle="Hintergrundfarbe der Seite"/>
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>

            <!-- ============================ Anordnen ============================ -->
            <ribbon:RibbonTab Header="Anordnen" KeyTip="A">
                <ribbon:RibbonGroup Header="Reihenfolge">
                    <ribbon:RibbonButton Label="In den Vordergrund" LargeImageSource="{s:Symbol Skizze=Vordergrund}" Tag="Anordnen.Vordergrund" Click="Befehl"/>
                    <ribbon:RibbonButton Label="In den Hintergrund" LargeImageSource="{s:Symbol Skizze=Hintergrund}" Tag="Anordnen.Hintergrund" Click="Befehl"/>
                    <ribbon:RibbonButton Label="Eine Ebene nach vorn" SmallImageSource="{s:Symbol Glyph=E74A}" Tag="Anordnen.Vor" Click="Befehl"/>
                    <ribbon:RibbonButton Label="Eine Ebene nach hinten" SmallImageSource="{s:Symbol Glyph=E74B}" Tag="Anordnen.Zurueck" Click="Befehl"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="Ausrichten">
                    <ribbon:RibbonMenuButton Label="Ausrichten" LargeImageSource="{s:Symbol Skizze=LinksAusrichten}" ToolTipTitle="Ausrichten" ToolTipDescription="Ein einzelnes Objekt wird an der Seite ausgerichtet, mehrere Objekte aneinander.">
                        <ribbon:RibbonMenuItem Header="Linksbündig" ImageSource="{s:Symbol Skizze=LinksAusrichten}" Tag="Ausrichten.Links" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="Horizontal zentriert" ImageSource="{s:Symbol Skizze=ZentrumAusrichten}" Tag="Ausrichten.Zentriert" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="Rechtsbündig" ImageSource="{s:Symbol Skizze=RechtsAusrichten}" Tag="Ausrichten.Rechts" Click="Befehl"/>
                        <ribbon:RibbonSeparator/>
                        <ribbon:RibbonMenuItem Header="Oben ausrichten" ImageSource="{s:Symbol Skizze=ObenAusrichten}" Tag="Ausrichten.Oben" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="Vertikal zentriert" ImageSource="{s:Symbol Skizze=MitteAusrichten}" Tag="Ausrichten.Mitte" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="Unten ausrichten" ImageSource="{s:Symbol Skizze=UntenAusrichten}" Tag="Ausrichten.Unten" Click="Befehl"/>
                        <ribbon:RibbonSeparator/>
                        <ribbon:RibbonMenuItem Header="An der Seite ausrichten (auch bei mehreren Objekten)" IsCheckable="True" Tag="Ausrichten.AnSeite" Click="Umschalter"/>
                    </ribbon:RibbonMenuButton>
                    <ribbon:RibbonMenuButton Label="Verteilen" LargeImageSource="{s:Symbol Skizze=Verteilen}">
                        <ribbon:RibbonMenuItem Header="Horizontal verteilen" Tag="Verteilen.Horizontal" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="Vertikal verteilen" Tag="Verteilen.Vertikal" Click="Befehl"/>
                    </ribbon:RibbonMenuButton>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="Objekte">
                    <ribbon:RibbonButton Label="Gruppieren" LargeImageSource="{s:Symbol Skizze=Gruppe}" Tag="Anordnen.Gruppieren" Click="Befehl"/>
                    <ribbon:RibbonButton Label="Gruppierung aufheben" LargeImageSource="{s:Symbol Skizze=GruppeAufheben}" Tag="Anordnen.Aufheben" Click="Befehl"/>
                    <ribbon:RibbonMenuButton Label="Drehen" LargeImageSource="{s:Symbol Skizze=Drehen}">
                        <ribbon:RibbonMenuItem Header="Um 90° nach rechts drehen" Tag="Drehen.Rechts" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="Um 90° nach links drehen" Tag="Drehen.Links" Click="Befehl"/>
                        <ribbon:RibbonMenuItem Header="Drehung zurücksetzen" Tag="Drehen.Null" Click="Befehl"/>
                    </ribbon:RibbonMenuButton>
                    <ribbon:RibbonButton Label="Sperren / Entsperren" LargeImageSource="{s:Symbol Skizze=Sperren}" Tag="Anordnen.Sperren" Click="Befehl"/>
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>

            <!-- ============================ Überprüfen ============================ -->
            <ribbon:RibbonTab Header="Überprüfen" KeyTip="Ü">
                <ribbon:RibbonGroup Header="Dokumentprüfung">
                    <ribbon:RibbonToggleButton x:Name="RechtschreibKnopf" Label="Rechtschreibung" LargeImageSource="{s:Symbol Skizze=Rechtschreibung}" Tag="Pruefen.Rechtschreibung" Click="Umschalter" ToolTipTitle="Rechtschreibprüfung" ToolTipDescription="Markiert beim Bearbeiten von Text unbekannte Wörter (Deutsch)."/>
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>

            <!-- ============================ Ansicht ============================ -->
            <ribbon:RibbonTab Header="Ansicht" KeyTip="N">
                <ribbon:RibbonGroup Header="Zoom">
                    <ribbon:RibbonButton Label="Ganze Seite" LargeImageSource="{s:Symbol Skizze=GanzeSeite}" Tag="Zoom.GanzeSeite" Click="Befehl"/>
                    <ribbon:RibbonButton Label="Seitenbreite" LargeImageSource="{s:Symbol Skizze=Seitenbreite}" Tag="Zoom.Seitenbreite" Click="Befehl"/>
                    <ribbon:RibbonButton Label="100 %" SmallImageSource="{s:Symbol Glyph=E71E}" Tag="Zoom.100" Click="Befehl"/>
                    <ribbon:RibbonButton Label="Vergrößern" SmallImageSource="{s:Symbol Glyph=E8A3}" Tag="Zoom.Plus" Click="Befehl"/>
                    <ribbon:RibbonButton Label="Verkleinern" SmallImageSource="{s:Symbol Glyph=E71F}" Tag="Zoom.Minus" Click="Befehl"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="Einblenden">
                    <ribbon:RibbonToggleButton x:Name="LinealKnopf" Label="Lineale" SmallImageSource="{s:Symbol Skizze=Lineal}" Tag="Ansicht.Lineale" Click="Umschalter"/>
                    <ribbon:RibbonToggleButton x:Name="NavigationKnopf" Label="Seitennavigation" SmallImageSource="{s:Symbol Skizze=Navigation}" Tag="Ansicht.Navigation" Click="Umschalter"/>
                    <ribbon:RibbonToggleButton x:Name="RaenderKnopf" Label="Ränder" SmallImageSource="{s:Symbol Skizze=Raender}" Tag="Ansicht.Raender" Click="Umschalter"/>
                    <ribbon:RibbonToggleButton x:Name="RasterKnopf" Label="Raster" SmallImageSource="{s:Symbol Skizze=Raster}" Tag="Ansicht.Raster" Click="Umschalter"/>
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="Ausrichtungshilfen">
                    <ribbon:RibbonToggleButton x:Name="ObjektFangKnopf" Label="An Objekten ausrichten" SmallImageSource="{s:Symbol Skizze=Fangen}" Tag="Fang.Objekt" Click="Umschalter"/>
                    <ribbon:RibbonToggleButton x:Name="RasterFangKnopf" Label="Am Raster ausrichten" SmallImageSource="{s:Symbol Skizze=Raster}" Tag="Fang.Raster" Click="Umschalter"/>
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>
        </ribbon:Ribbon>

        <!-- ============================ Arbeitsbereich ============================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationSpalte" Width="170"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="SeitenListe" Grid.Column="0" Background="#F3F3F3" BorderThickness="0,0,1,0" BorderBrush="#D0D0D0"
                     HorizontalContentAlignment="Stretch" SelectionChanged="SeiteInListeGewaehlt" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,6,6,4">
                            <Border BorderBrush="#9A9A9A" BorderThickness="1" Background="White" HorizontalAlignment="Center">
                                <Image Source="{Binding Vorschau}" Width="120" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="{Binding Nummer}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Leere Seite danach einfügen" Tag="Seite.Neu" Click="Befehl"/>
                        <MenuItem Header="Seite duplizieren" Tag="Seite.Duplizieren" Click="Befehl"/>
                        <MenuItem Header="Seite löschen" Tag="Seite.Loeschen" Click="Befehl"/>
                        <Separator/>
                        <MenuItem Header="Nach vorn" Tag="Seite.Vor" Click="Befehl"/>
                        <MenuItem Header="Nach hinten" Tag="Seite.Zurueck" Click="Befehl"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" x:Name="NavigationTeiler"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="LinealZeile" Height="22"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LinealSpalte" Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Background="#F0F0F0"/>
                <Grid Grid.Row="0" Grid.Column="1" x:Name="LinealOben" ClipToBounds="True"/>
                <Grid Grid.Row="1" Grid.Column="0" x:Name="LinealLinks" ClipToBounds="True"/>

                <ScrollViewer x:Name="Bildlauf" Grid.Row="1" Grid.Column="1" Background="#E3E3E3"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="BildlaufRad" ScrollChanged="BildlaufGeaendert" Focusable="False">
                    <StackPanel x:Name="SeitenStapel" Margin="32,26,32,26" HorizontalAlignment="Center"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============================ Statusleiste ============================ -->
        <StatusBar Grid.Row="2" Background="#2B579A" Foreground="White">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False"/>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal">
                    <Button Content="−" Width="22" Height="20" Padding="0" Tag="Zoom.Minus" Click="Befehl" ToolTip="Verkleinern"/>
                    <Slider x:Name="ZoomRegler" Width="130" Minimum="10" Maximum="400" Value="100" Margin="8,0" VerticalAlignment="Center"
                            ValueChanged="ZoomReglerGeaendert" TickFrequency="10" IsMoveToPointEnabled="True"/>
                    <Button Content="+" Width="22" Height="20" Padding="0" Tag="Zoom.Plus" Click="Befehl" ToolTip="Vergrößern"/>
                    <TextBlock x:Name="ZoomText" Text="100 %" Width="48" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock x:Name="StatusSeite" Text="Seite 1 von 1"/>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock x:Name="StatusAuswahl" Margin="20,0,0,0"/>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock x:Name="StatusMeldung" Margin="20,0,0,0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</ribbon:RibbonWindow>
