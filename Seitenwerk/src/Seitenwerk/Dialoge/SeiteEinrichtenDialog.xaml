<Window x:Class="Seitenwerk.Dialoge.SeiteEinrichtenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seite einrichten" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Seitengröße" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Papierformat:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <ComboBox x:Name="FormatBox" Grid.Column="1" Grid.ColumnSpan="3" Width="260" Margin="0,0,0,6" SelectionChanged="FormatGewaehlt"/>
                <TextBlock Text="Breite (mm):" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox x:Name="BreiteBox" Grid.Row="1" Grid.Column="1" Width="80" Margin="0,0,16,6" TextChanged="MasseGeaendert"/>
                <TextBlock Text="Höhe (mm):" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox x:Name="HoeheBox" Grid.Row="1" Grid.Column="3" Width="80" Margin="0,0,0,6" TextChanged="MasseGeaendert"/>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal">
                    <RadioButton x:Name="HochBox" Content="Hochformat" Margin="0,0,16,0" Checked="AusrichtungGewaehlt"/>
                    <RadioButton x:Name="QuerBox" Content="Querformat" Checked="AusrichtungGewaehlt"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Header="Ränder (mm)" Grid.Row="1" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Oben:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox x:Name="ObenBox" Grid.Column="1" Width="80" Margin="0,0,16,6"/>
                <TextBlock Text="Unten:" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox x:Name="UntenBox" Grid.Column="3" Width="80" Margin="0,0,0,6"/>
                <TextBlock Text="Links:" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="LinksBox" Grid.Row="1" Grid.Column="1" Width="80" Margin="0,0,16,0"/>
                <TextBlock Text="Rechts:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="RechtsBox" Grid.Row="1" Grid.Column="3" Width="80"/>
            </Grid>
        </GroupBox>

        <TextBlock x:Name="FehlerText" Grid.Row="2" Foreground="#C00000" TextWrapping="Wrap" MaxWidth="360" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="90" Margin="0,0,8,0" IsDefault="True" Click="OkKlick"/>
            <Button Content="Abbrechen" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
