<Window x:Class="Seitenwerk.Dialoge.FortschrittFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seitenwerk" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" WindowStyle="ToolWindow">
    <StackPanel Margin="20">
        <TextBlock x:Name="Meldung" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <ProgressBar x:Name="Balken" Height="16" IsIndeterminate="True"/>
        <Button x:Name="AbbrechenKnopf" Content="Abbrechen" Width="90" HorizontalAlignment="Right" Margin="0,16,0,0" Click="AbbrechenKlick"/>
    </StackPanel>
</Window>
