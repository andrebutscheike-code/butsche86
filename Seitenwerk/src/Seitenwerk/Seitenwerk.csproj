<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Seitenwerk</RootNamespace>
    <AssemblyName>Seitenwerk</AssemblyName>
    <ApplicationIcon>Seitenwerk.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Seitenwerk</Product>
    <Description>Layoutprogramm für Flyer, Plakate und Broschüren</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Seitenwerk.Core\Seitenwerk.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Seitenwerk.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Seitenwerk.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.13" />
  </ItemGroup>

</Project>
